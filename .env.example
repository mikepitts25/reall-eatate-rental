# ---------------------------------------------------------------------------
# LeaseFlip environment variables
# Copy to `.env.local` and fill in with your Supabase project credentials.
# Find these under: Supabase Dashboard > Project Settings > API
# ---------------------------------------------------------------------------

# Public — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — NEVER expose to the browser. Used by admin/server actions
# that must bypass RLS (e.g. moderation tooling, webhooks).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App URL — used for auth redirect callbacks
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# E-signature provider (optional)
# Leave unset to use the built-in in-app signing. Set to "documenso" and fill
# in the keys below to route agreement signing through Documenso once the
# integration is implemented (see src/lib/agreements/provider.ts).
# ---------------------------------------------------------------------------
# ESIGN_PROVIDER=documenso
# DOCUMENSO_API_URL=https://app.documenso.com
# DOCUMENSO_API_KEY=your-documenso-api-key
